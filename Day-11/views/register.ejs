<!DOCTYPE html> 
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <link rel="stylesheet" href="/styles/theme.css">
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <main class="register-container">
        <form class="register-form" method="POST" action="/auth/register">
            <h1>Register</h1>
            
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required autocomplete="email" placeholder="Enter your email">
            </div>
            
            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" required autocomplete="username" placeholder="Choose a username">
            </div>
            
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required autocomplete="new-password" placeholder="Create a password">
            </div>
            
            <button type="submit" class="register-btn">Sign Up</button>

            <!-- Added this section -->
            <p class="login-link">
                Already have an account? <a href="/auth/login">Login</a>
            </p>
        </form>
    </main>
</body>
</html>
